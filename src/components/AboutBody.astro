---
import { about, profile } from '../site.config';
import Icon from './Icon.astro';

const sections = about.sections;

// Paint the accent phrase inside the thesis without writing it twice —
// same trick as the overview hero.
const phrase = profile.thesisAccent;
const hasPhrase = phrase.length > 0 && profile.thesis.includes(phrase);
const cut = hasPhrase ? profile.thesis.indexOf(phrase) : 0;
const before = hasPhrase ? profile.thesis.slice(0, cut) : profile.thesis;
const after = hasPhrase ? profile.thesis.slice(cut + phrase.length) : '';

// Contact pills carry an icon. An explicit `icon` in config wins;
// otherwise the href identifies the service, and a plain writing link
// gets a pen. Anything unknown falls back to a chain link.
const iconFor = (link: { label: string; href: string; icon?: string }) => {
  if (link.icon) return link.icon;
  const href = link.href.toLowerCase();
  const label = link.label.toLowerCase();
  if (href.startsWith('mailto:')) return 'mail';
  if (href.includes('github.com')) return 'github';
  if (href.includes('linkedin.com')) return 'linkedin';
  if (href.includes('x.com') || href.includes('twitter.com')) return 'x';
  if (href.includes('instagram.com')) return 'instagram';
  if (label === 'writing' || label === 'blog') return 'pen';
  return 'link';
};
---

<div class="about">
  <p class="about__lead" data-reveal>
    {before}{hasPhrase && <span class="hl">{phrase}</span>}{after}
  </p>

  {
    sections.map((section, index) => (
      <section
        class="about-block"
        id={section.id}
        aria-labelledby={`about-${section.id}`}
        data-reveal
      >
        <div class="about-block__head">
          <span class="section__num" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h2 id={`about-${section.id}`}>{section.title}</h2>
          {section.kicker && <span class="about-block__kicker">{section.kicker}</span>}
        </div>

        {section.intro && <p class="about-block__intro">{section.intro}</p>}

        {section.paragraphs && (
          <div class="about-block__body">
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )}

        {section.items && (
          <dl class="about-facts">
            {section.items.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
        )}

        {section.points && (
          <ul class="about-points">
            {section.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        )}

        {section.quote && (
          <blockquote class="about-quote">
            <p>{section.quote}</p>
            {section.quoteBy && <cite>{section.quoteBy}</cite>}
          </blockquote>
        )}

        {section.links && (
          <div class="about-links">
            {section.links.map((link) => (
              <a
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                <Icon name={iconFor(link)} size={14} />
                {link.label}
              </a>
            ))}
          </div>
        )}
      </section>
    ))
  }
</div>
